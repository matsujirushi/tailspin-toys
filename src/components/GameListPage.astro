---
import type { PaginatedGames } from '../lib/games';
import EmptyState from './EmptyState.astro';
import GameCard from './GameCard.astro';
import PageHero from './PageHero.astro';
import Pagination from './Pagination.astro';
import type { Category, Publisher } from '../types/game';

interface Props {
  /** Categories available in the game filter. */
  categories: Category[];
  /** Publishers available in the game filter. */
  publishers: Publisher[];
  /** Games and metadata for the current list page. */
  pagination: PaginatedGames;
}

const { categories, publishers, pagination } = Astro.props;
const { games, currentPage, totalPages } = pagination;
const currentPath = currentPage === 1 ? '/' : `/page/${currentPage}`;
---

<div class="py-8">
  <PageHero
    title="Welcome to Tailspin Toys"
    subtitle="Find your next game! And maybe even back one! Explore our collection!"
  />

  <div>
    <form
      method="GET"
      action={currentPath}
      class="mb-8 rounded-xl border border-slate-700 bg-slate-800 p-6"
      data-testid="games-filters-form"
    >
      <fieldset class="mb-6">
        <legend class="mb-3 font-semibold text-slate-100">Filter by category</legend>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {categories.map((category) => (
            <label class="flex items-center gap-2 text-slate-200" data-testid={`category-filter-option-${category.id}`}>
              <input
                type="checkbox"
                name="category"
                value={category.id}
                class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid={`category-filter-checkbox-${category.id}`}
              />
              <span>{category.name}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mb-6">
        <label for="publisher-filter" class="mb-2 block font-semibold text-slate-100">Filter by publisher</label>
        <select
          id="publisher-filter"
          name="publisher"
          class="w-full max-w-sm rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="publisher-filter-select"
        >
          <option value="">All publishers</option>
          {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
        </select>
      </div>

      <div class="flex flex-wrap gap-3">
        <button
          type="submit"
          class="rounded-lg bg-blue-600 px-4 py-2 text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="apply-filters-button"
        >
          Apply filters
        </button>
        <a
          href={currentPath}
          class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
          data-testid="clear-filters-link"
        >
          Clear filters
        </a>
      </div>
    </form>

    <h2 class="mb-6 text-2xl font-medium text-slate-100">Featured Games</h2>

    {games.length === 0 ? (
      <EmptyState text="No games available at the moment." />
    ) : (
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid" data-filterable-games>
        {games.map((game) => <GameCard {game} />)}
      </div>
    )}
    <p class="hidden text-slate-300" data-testid="filtered-empty-state" role="status" aria-live="polite">
      No games found for the selected filters.
    </p>

    <Pagination {currentPage} {totalPages} />
  </div>
</div>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="games-filters-form"]');
  const grid = document.querySelector<HTMLElement>('[data-filterable-games]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');

  if (form && grid && emptyState) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const categoryCheckboxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="category"]'));
    const publisherSelect = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const applyFilters = (updateUrl: boolean): void => {
      const selectedCategories = categoryCheckboxes
        .filter((checkbox) => checkbox.checked)
        .map((checkbox) => checkbox.value);
      const publisher = publisherSelect?.value ?? '';
      const visibleCards = cards.filter((card) => {
        const categoryMatches =
          selectedCategories.length === 0 || selectedCategories.includes(card.dataset.gameCategoryId ?? '');
        const publisherMatches = publisher === '' || publisher === (card.dataset.gamePublisherId ?? '');
        card.classList.toggle('hidden', !categoryMatches || !publisherMatches);
        return categoryMatches && publisherMatches;
      });

      emptyState.classList.toggle('hidden', visibleCards.length > 0);
      grid.classList.toggle('hidden', visibleCards.length === 0);

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.search = '';
        selectedCategories.forEach((category) => url.searchParams.append('category', category));
        if (publisher) url.searchParams.set('publisher', publisher);
        window.history.replaceState({}, '', url);
      }
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = new Set(params.getAll('category'));
    categoryCheckboxes.forEach((checkbox) => {
      checkbox.checked = selectedCategories.has(checkbox.value);
    });
    if (publisherSelect) publisherSelect.value = params.get('publisher') ?? '';
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters(true);
    });
    applyFilters(false);
  }
</script>
